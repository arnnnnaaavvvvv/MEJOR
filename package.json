    "audit:verbose": "node ./bin/cli.js . --verbose",
    "audit:fix": "node ./bin/cli.js . --prompts",
    "audit:security": "node ./bin/cli.js . --security-only",
    "audit:backend": "node ./bin/cli.js . --backend-only",
    "audit:leakage": "node ./bin/cli.js . --leakage-only"
  },
