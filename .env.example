# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Databases
DATABASE_URL=sqlite+aiosqlite:///./auditor.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+asyncpg://auditor_user:auditor_secure_password@localhost:5432/auditor

REDIS_URL=redis://localhost:6379/0
ARTIFACTS_DIR=./artifacts

# Rate Limiting & Resource Constraints
RATE_LIMIT_PER_MINUTE=20
JOB_TIMEOUT_SECONDS_QUICK=90
JOB_TIMEOUT_SECONDS_DEEP=300
MAX_CRAWL_PAGES=5

# LLM Providers (Optional for local testing, mocked if empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=mock
